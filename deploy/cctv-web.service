[Unit]
Description=CCTV recordings web application
After=network.target cctv-web.socket
Requires=cctv-web.socket
RequiresMountsFor=/opt/cctv-web /srv/cctv
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=cctv-web
Group=cctv-web
SupplementaryGroups=cctv
WorkingDirectory=/opt/cctv-web
EnvironmentFile=/opt/cctv-web/deploy/cctv-web.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/run/cctv-web
ExecStartPre=/opt/cctv-web/.venv/bin/python /opt/cctv-web/deploy/preflight.py
ExecStart=/opt/cctv-web/.venv/bin/python /opt/cctv-web/deploy/serve.py
Sockets=cctv-web.socket
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
RuntimeDirectory=cctv-web
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @clock @module
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/cctv-web /srv/cctv
ReadWritePaths=/opt/cctv-web/var/cache /run/cctv-web /var/lib/cctv-persons/requests
InaccessiblePaths=/etc/cctv /etc/nginx /etc/letsencrypt -/run/dbus -/run/systemd/private
RestrictAddressFamilies=AF_UNIX

MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
CPUQuota=300%
CPUQuotaPeriodSec=100ms

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cctv-web

[Install]
WantedBy=multi-user.target
