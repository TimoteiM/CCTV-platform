server {

    server_name dumitriu-cctv.duckdns.org;

    # Authentication is enforced by the application and internal media subrequests.

    autoindex off;
    server_tokens off;
    client_max_body_size 4k;
    access_log /var/log/nginx/cctv-access.log cctv_safe;
    error_log /var/log/nginx/cctv-error.log warn;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    location = /_cctv_auth {
        internal;
        proxy_pass http://127.0.0.1:8080/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host dumitriu-cctv.duckdns.org;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host dumitriu-cctv.duckdns.org;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cache-Control;
        proxy_hide_header Content-Security-Policy;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering on;
    }

    location ~ "^/_cctv_originals/(cam0[1-8])/([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}\.mkv)$" {
        internal;
        auth_request /_cctv_auth;
        alias /srv/cctv/$1/$2;
        disable_symlinks on;
        types { }
        default_type video/x-matroska;
        max_ranges 1;
    }
    location /_cctv_originals/ { internal; return 404; }

    location ~ "^/_cctv_playback/([a-f0-9]{64})\.mp4$" {
        internal;
        auth_request /_cctv_auth;
        alias /opt/cctv-web/var/cache/$1.mp4;
        disable_symlinks on;
        types { }
        default_type video/mp4;
        max_ranges 1;
    }
    location /_cctv_playback/ { internal; return 404; }

    location ~ "^/_cctv_live/(cam0[1-8])/([a-f0-9]{32})/(index\.m3u8|seg[0-9]{5,}\.ts)$" {
        internal;
        auth_request /_cctv_auth;
        alias /var/cache/cctv-live/$1/$2/$3;
        disable_symlinks on;
        types { application/vnd.apple.mpegurl m3u8; video/mp2t ts; }
        default_type application/octet-stream;
        max_ranges 1;
        log_not_found off;
    }
    location /_cctv_live/ { internal; return 404; }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dumitriu-cctv.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dumitriu-cctv.duckdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = dumitriu-cctv.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;

    server_name dumitriu-cctv.duckdns.org;
    return 404; # managed by Certbot


}