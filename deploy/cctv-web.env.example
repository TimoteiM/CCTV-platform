# Application settings only. No camera credentials or authentication secrets.
CCTV_RECORDINGS_ROOT=/srv/cctv
CCTV_CAMERA_NAMES=/opt/cctv-web/cameras.json
CCTV_MINIMUM_AGE=60
CCTV_DOWNLOAD_MODE=nginx
CCTV_CACHE_ROOT=/opt/cctv-web/var/cache
CCTV_CACHE_MAX_AGE=21600
CCTV_CACHE_MAX_BYTES=2147483648
CCTV_PLAYBACK_QUEUE_SIZE=3
CCTV_CONVERSION_TIMEOUT=900
CCTV_PERSON_EVENTS_ROOT=/var/lib/cctv-persons
CCTV_FRIGATE_EVENTS_ROOT=/var/lib/cctv-frigate-events
CCTV_AUTH_CREDENTIALS=/etc/cctv-web-auth/users
CCTV_AUTH_STATE=/var/lib/cctv-auth
