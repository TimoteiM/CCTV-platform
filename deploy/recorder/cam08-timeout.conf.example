[Service]
# Bound stalled reads; the recording watchdog also verifies actual writes.
ExecStart=
ExecStart=/usr/bin/ffmpeg \
  -hide_banner \
  -loglevel warning \
  -rtsp_transport tcp \
  -timeout 15000000 \
  -i rtsp://${CAM_USER}:${CAM_PASS}@${HOME_PUBLIC_IP}:15548/mpeg4 \
  -map 0 \
  -c copy \
  -f segment \
  -segment_time 300 \
  -segment_atclocktime 1 \
  -reset_timestamps 1 \
  -strftime 1 \
  /srv/cctv/cam08/%%Y-%%m-%%d_%%H-%%M-%%S.mkv

TimeoutStopSec=20
